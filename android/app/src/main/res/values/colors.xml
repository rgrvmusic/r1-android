<!--
    The panel's palette as Android colours: the background from the synth's
    black, the button and label greys from the ImGui panel, and the red from
    the banner.

    AAPT rejects a comment containing a double hyphen.
-->
<resources>

    <!-- The banner red. -->
    <color name="colorPrimary">#CF1A37</color>

    <!-- The same red when pressed. -->
    <color name="colorPrimaryPressed">#E83352</color>

    <!-- Below the black of the synth panel. -->
    <color name="colorBackground">#0E0F12</color>

    <!-- A shade above the background, for file rows. -->
    <color name="colorSurface">#1E2024</color>

    <!-- The button fill. -->
    <color name="colorButton">#26282C</color>

    <!-- The label grey. -->
    <color name="colorSecondaryText">#969BA5</color>

    <!-- The label white. -->
    <color name="colorOnBackground">#DCE0E6</color>

</resources>
